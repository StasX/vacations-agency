# Local development only. Copy to .env.development.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vacation_agency
MYSQL_USER=agency_dev
MYSQL_PASSWORD=development-only-mysql-password
MYSQL_ROOT_PASSWORD=development-only-root-password
REDIS_PASSWORD=development-only-redis-password
JWT_REDIS_URL=redis://127.0.0.1:6379/0
JWT_REDIS_PASSWORD=development-only-redis-password
SECRET_KEY=development-only-django-signing-key-at-least-32-bytes
SESSION_SECRET_KEY=development-only-flask-session-key-at-least-32-bytes
PASSWORDS_SALT=development-only-legacy-salt
ISSUER=vacations-development
AUDIENCE=vacations-development
APP_ENV=development
DJANGO_SETTINGS_MODULE=api.settings.development
DJANGO_DEBUG=true
DJANGO_COOKIE_SECURE=false
FLASK_COOKIE_SECURE=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],vacations-statistics
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
