# Copy to .env.production and populate every empty credential with unique secrets.
# Supply the actual public domains/origins. HTTPS terminates at your reverse proxy.
MYSQL_HOST=vacations-database
MYSQL_PORT=3306
MYSQL_DATABASE=vacation_agency
MYSQL_USER=agency_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
SESSION_SECRET_KEY=
# Preserve the existing legacy salt when upgrading an existing installation.
PASSWORDS_SALT=
ISSUER=vacations-agency
AUDIENCE=vacations-dashboard
APP_ENV=production
DJANGO_SETTINGS_MODULE=api.settings.production
DJANGO_DEBUG=false
DJANGO_COOKIE_SECURE=true
FLASK_COOKIE_SECURE=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],agency.example.com
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=https://agency.example.com
