# Django: hosts are names/IPs without ports; CORS origins include scheme and port.
# Add your public hostname or server IP to DJANGO_ALLOWED_HOSTS for remote access.
# Nginx preserves the browser Host header, so use the frontend hostname here too.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Same-origin React proxy needs no CORS. For a separate frontend, e.g. http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=
# Keep true on HTTPS deployments; set false only for local HTTP development.
DJANGO_COOKIE_SECURE=true
# Explicit trusted frontend origins for cross-origin CSRF (separate from CORS).
DJANGO_CSRF_TRUSTED_ORIGINS=

# MySQL variables
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agency_user
MYSQL_PASSWORD=agency_pass
MYSQL_DATABASE=vacation_agency
MYSQL_ROOT_PASSWORD=root_pass

# Auth variables
# For Django outside Docker; Compose uses its internal Redis service.
JWT_REDIS_URL=redis://localhost:6379/0
SESSION_SECRET_KEY=base64:MiIdtX2yS+VOQaKgFspOHwH/pbCDDhJMWQe3C4WoI/A=
PASSWORDS_SALT=salty_pass
